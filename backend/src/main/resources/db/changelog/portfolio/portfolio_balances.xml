<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
        xmlns:pro="http://www.liquibase.org/xml/ns/pro"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
		http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
		http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd
		http://www.liquibase.org/xml/ns/pro http://www.liquibase.org/xml/ns/pro/liquibase-pro-latest.xsd">

    <changeSet id="createPortfolioBalances" author="larionov">
        <preConditions>
            <not>
                <tableExists tableName="portfolio_balances"/>
            </not>
        </preConditions>

        <createTable tableName="portfolio_balances">
            <column name="id" type="uuid">
                <constraints unique="true" nullable="false"/>
            </column>

            <column name="usd" type="numeric">
                <constraints nullable="false"/>
            </column>
            <column name="rub" type="numeric">
                <constraints nullable="false"/>
            </column>

            <column name="date" type="timestamp">
                <constraints nullable="false"/>
            </column>

        </createTable>

        <addPrimaryKey tableName="portfolio_balances" columnNames="id" constraintName="portfolio_balances.pk"/>
    </changeSet>

</databaseChangeLog>